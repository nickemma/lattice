# Optional local shell configuration. Copy to .env only when a tool needs it;
# Docker Compose does not require a .env file for its default development path.
LATTICE_URL=http://localhost:8080
LATTICE_API_KEY=
LATTICE_E2E_API_KEY=
LATTICE_BENCH_QUERIES=1000
LATTICE_BENCH_CONCURRENCY=16

# Kubernetes/Terraform: prefer a secret manager or TF_VAR_* environment value.
# Never replace this file with real credentials in Git.
TF_VAR_opensearch_admin_password=
